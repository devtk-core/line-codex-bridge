# Store real values in a root-owned systemd EnvironmentFile, not in this file.
LINE_CHANNEL_SECRET=replace-me
LINE_CHANNEL_ACCESS_TOKEN=replace-me
LINE_ALLOWED_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Directory Codex may edit. Use a dedicated project directory.
CODEX_WORKDIR=/srv/codex-workspace
CODEX_BIN=/home/pi/.local/bin/codex

HOST=127.0.0.1
PORT=8080
CODEX_TIMEOUT_SECONDS=1800
MAX_MESSAGE_CHARS=4000

# Optional. When set, only messages beginning with this prefix are executed.
# COMMAND_PREFIX=/codex

# Group/room messages are rejected by default to avoid leaking Codex output.
ALLOW_GROUPS=false
