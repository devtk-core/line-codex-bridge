[Unit]
Description=LINE to local Codex bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change this to the Linux user that already has a working Codex login.
User=pi
Group=pi
WorkingDirectory=/opt/codex-line
EnvironmentFile=/etc/codex-line.env
ExecStart=/usr/bin/python3 -m codex_line.server
Restart=on-failure
RestartSec=5

# Service hardening. ReadWritePaths must include CODEX_WORKDIR.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/codex-workspace

[Install]
WantedBy=multi-user.target
